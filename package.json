{
  "name": "reelscript",
  "version": "0.0.0",
  "description": "Product demos as code. Write a script, render a demo, re-run it in CI when your UI changes.",
  "type": "module",
  "license": "MIT",
  "author": "Trevin Lee",
  "keywords": [
    "demo",
    "screencast",
    "screen-recording",
    "video",
    "automation",
    "playwright",
    "demo-as-code"
  ],
  "bin": {
    "reelscript": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "preview": "tsx src/cli.ts preview examples/basic.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
